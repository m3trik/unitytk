      {
        "behavior": "play",
        "targets": "none",
        "clip": true,
        "pass": {
          "playSpeed": "speed"
        }
      }
    ],
    "button": [
      {
        "if": {
          "to": "retry"
        },
        "behavior": "option",
        "fields": {
          "label": "{label}"
        },
        "pass": {
          "wrongChoiceReply": "reply"
        }
      },
      {
        "if": {
          "to": "next",
          "any": {
            "to": "retry"
          }
        },
        "behavior": "option",
        "fields": {
          "label": "{label}",
          "value": "correct"
        }
      },
      {
        "if": {
          "to": "next",
          "when": "start"
        },
        "behavior": "pause",
