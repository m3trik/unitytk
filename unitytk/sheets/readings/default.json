        "nodes": {
          "facing": "target"
        },
        "order": "start",
        "until": {
          "by": "ring",
          "shows": {
            "behavior": "marker"
          },
          "behavior": "marker",
          "settings": {
            "markerShow": "Hide"
          },
          "targets": "where"
        }
      },
      {
        "if": {
          "when": "end"
        },
        "behavior": "teleport",
        "targets": "where",
        "order": "end",
        "until": {
          "by": "ring",
          "shows": {
            "behavior": "marker"
          },
          "behavior": "marker",
          "settings": {
            "markerShow": "Hide"
          },
          "targets": "where"
