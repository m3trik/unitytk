{
  "word": "answer",
  "order": 82,
  "description": "Entering any other value goes to a step (its Label `*`).",
  "detect": [
    "^when\\s+any\\s+(?:number|answer|value)\\s+other\\s+than\\s+\\S+\\s+is\\s+entered\\s+advance\\s+to\\s+step\\s+(?P<to>{step})$",
    "^entering\\s+any\\s+other\\s+(?:number|answer|value)\\s+triggers\\s+(?:advancement\\s+to\\s+)?step\\s+(?P<to>{step})$"
  ],
  "fields": {
    "label": "*"
  },
  "roles": [
    "advances",
    "entered",
    "otherwise"
  ]
}
