{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "timeout": 10,
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agents/session_hook.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agents/generated_files_hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
